    "category": "Productivity",
    "shortDescription": "工作回顾与护眼节奏助手",
    "longDescription": "本地优先地记录工作轨迹、整理日报，并在工作间隙守护双眼。",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": "WorkReview Self-Signed",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "xdotool",
          "xprintidle",
          "x11-utils",
          "libglib2.0-bin",
          "tesseract-ocr",
          "gnome-screenshot | grim | scrot | maim | imagemagick",
          "procps"
        ]
      },
      "rpm": {
        "depends": [
          "xdotool",
          "xprintidle",
          "xorg-x11-utils",
          "glib2",
          "tesseract",
          "gnome-screenshot",
          "procps-ng"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "productName": "WorkBreath",
  "mainBinaryName": "WorkBreath",
  "version": "1.5.9",
  "identifier": "com.workbreath.app",
  "plugins": {
    "updater": {
